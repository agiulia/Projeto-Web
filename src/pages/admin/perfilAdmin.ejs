<%- include('../partials/header', { titulo: 'Perfil Administrativo | Biblioteca' }) %>

<main class="container my-5 flex-grow-1">

    <div class="bg-white p-4 rounded shadow">

        <h2 class="text-primary mb-4">Perfil do administrador</h2>

        <div class="bg-light border rounded p-4 mb-4">
            <h4>Informações da conta</h4>

            <p><strong>Nome:</strong> <%= usuario.name %></p>
            <p><strong>E-mail:</strong> <%= usuario.email %></p>
            <p class="mb-0">
                <strong>Tipo de conta:</strong>
                <span class="badge bg-primary">Administrador</span>
            </p>
        </div>

        <div class="bg-light border rounded p-4 mb-4">
            <h4 class="text-primary mb-3">Editar informações</h4>

            <form id="formPerfil" action="/usuarios/perfil" method="POST">

                <div class="mb-3">
                    <label for="nome" class="form-label">Nome</label>
                    <input type="text" class="form-control" id="nome" name="name"
                        value="<%= usuario.name %>" required>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">E-mail</label>
                    <input type="email" class="form-control" id="email" name="email"
                        value="<%= usuario.email %>" required>
                </div>

                <button type="submit" class="btn btn-primary">Salvar alterações</button>
            </form>
        </div>

        <div class="bg-light border rounded p-4 mb-4">
            <h4 class="text-primary mb-3">Gerenciamento</h4>
            <p>Acesse as ferramentas administrativas da biblioteca.</p>

            <div class="d-flex flex-wrap gap-2">
                <a href="/admin" class="btn btn-outline-primary">Painel administrativo</a>
                <a href="/admin/usuarios" class="btn btn-outline-primary">Gerenciar usuários</a>
                <a href="/admin/livros" class="btn btn-outline-primary">Gerenciar livros</a>
            </div>
        </div>

        <a href="/" class="btn btn-outline-primary">Voltar</a>

    </div>

</main>

<%- include('../partials/footer') %>