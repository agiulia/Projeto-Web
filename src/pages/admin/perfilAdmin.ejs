<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel ADM | Biblioteca</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light min-vh-100 d-flex flex-column">

    <header class="bg-primary text-white p-4">
        <h1>Biblioteca</h1>

        <nav>
            <ul class="nav">
                <li class="nav-item">
                    <a class="nav-link text-white" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="/usuarios/perfil">Perfil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="/usuarios/logout">Sair</a>
                </li>
            </ul>
        </nav>
    </header>

    <main class="container my-5 flex-grow-1">

        <div class="bg-white p-4 rounded shadow">

            <h2 class="text-primary mb-4">Painel do administrador</h2>

            <% if (erro) { %>
                <div class="alert alert-danger"><%= erro %></div>
            <% } %>

            <div class="bg-light border rounded p-4 mb-4">
                <h4>Informações da conta</h4>
                <p><strong>Nome:</strong> <%= usuario.name %></p>
                <p><strong>E-mail:</strong> <%= usuario.email %></p>
                <p class="mb-0"><strong>Tipo de conta:</strong> Administrador</p>
            </div>

            <div class="bg-light border rounded p-4">
                <h4 class="text-primary mb-3">Empréstimos</h4>

                <% if (emprestimos.length === 0) { %>
                    <p class="mb-0">Nenhum empréstimo ainda.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover bg-white">
                            <thead class="table-primary">
                                <tr>
                                    <th>Usuário</th>
                                    <th>Livro</th>
                                    <th>Data</th>
                                    <th>Status</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% emprestimos.forEach((emp) => { %>
                                    <tr>
                                        <td><%= emp.usuario %></td>
                                        <td><%= emp.titulo %></td>
                                        <td><%= emp.data %></td>
                                        <td>
                                            <% if (emp.status === 'aceito') { %>
                                                <span class="badge bg-success"><%= emp.statusLabel %></span>
                                            <% } else if (emp.status === 'pendente') { %>
                                                <span class="badge bg-warning text-dark"><%= emp.statusLabel %></span>
                                            <% } else { %>
                                                <span class="badge bg-secondary"><%= emp.statusLabel %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (emp.status === 'pendente') { %>
                                                <form action="/admin/emprestimos/<%= emp.id %>/aceitar" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-success btn-sm">Aceitar</button>
                                                </form>
                                                <form action="/admin/emprestimos/<%= emp.id %>/recusar" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-danger btn-sm">Recusar</button>
                                                </form>
                                            <% } else { %>
                                                -
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>

            <a href="/" class="btn btn-outline-primary mt-4">Voltar</a>

        </div>

    </main>

    <footer class="bg-white text-center p-3 border-top mt-auto">
        <p class="mb-0">© 2026 Biblioteca. Todos os direitos reservados.</p>
    </footer>

</body>
</html>