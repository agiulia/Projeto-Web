<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof titulo !== 'undefined' ? titulo : 'Biblioteca' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light min-vh-100 d-flex flex-column">

    <header class="bg-primary text-white p-4">
        <h1>Bem-vindo à Biblioteca</h1>

        <nav>
            <ul class="nav">
                <li class="nav-item">
                    <a class="nav-link text-white" href="/">Home</a>
                </li>

                <% if (!usuario) { %>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/usuarios/login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/usuarios/cadastro">Cadastro</a>
                    </li>
                <% } %>

                <li class="nav-item">
                    <a class="nav-link text-white" href="/interface">Interface</a>
                </li>

                <% if (usuario) { %>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/usuarios/perfil">Perfil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/usuarios/logout">Sair</a>
                    </li>
                <% } %>

                <% if (usuario && usuario.role === 'admin') { %>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/admin/perfilAdmin">ADM</a>
                    </li>
                <% } %>
            </ul>
        </nav>
    </header>