<div class="bg-white p-4 rounded shadow mb-4">
    <div class="row g-4">

        <div class="col-12 col-md-5">
            <div class="bg-light border rounded d-flex align-items-center justify-content-center h-100 p-5">
                <% if (livro.thumbnail) { %>
                    <img src="<%= livro.thumbnail %>"
                        alt="Capa de <%= livro.title %>"
                        class="img-fluid rounded">
                <% } else { %>
                    <span class="text-muted">Sem capa</span>
                <% } %>
            </div>
        </div>

        <div class="col-12 col-md-7">
            <div class="bg-light border rounded p-4 mb-4">
                <h2 class="text-primary"><%= livro.title %></h2>
                <p><strong>Autor:</strong> <%= livro.authors.join(', ') %></p>
            </div>

            <div class="bg-light border rounded p-4 mb-4">
                <h3 class="text-primary">Sinopse</h3>
                <p><%= livro.description %></p>
            </div>

            <div class="bg-light border rounded p-3">
                <% if (usuario) { %>
                    <form action="/emprestimos" method="POST">
                        <input type="hidden" name="isbn" value="<%= livro.isbn || livro.id %>">
                        <input type="hidden" name="titulo" value="<%= livro.title %>">
                        <input type="hidden" name="autores" value="<%= livro.authors.join(', ') %>">
                        <input type="hidden" name="thumbnail" value="<%= livro.thumbnail || '' %>">
                        <input type="hidden" name="descricao" value="<%= livro.description || '' %>">
                        <button type="submit" class="btn btn-primary w-100">Reservar livro</button>
                    </form>
                <% } else { %>
                    <a href="/usuarios/login" class="btn btn-outline-primary w-100">Entre para reservar</a>
                <% } %>
            </div>
        </div>

    </div>
</div>