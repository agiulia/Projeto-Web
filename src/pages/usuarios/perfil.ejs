<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu Perfil | Biblioteca</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light min-vh-100 d-flex flex-column">

    <header class="bg-primary text-white p-4">
        <h1>Biblioteca</h1>

        <nav>
            <ul class="nav">
                <li class="nav-item">
                    <a class="nav-link text-white" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="/interface">Livros</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="/usuarios/logout">Sair</a>
                </li>
            </ul>
        </nav>
    </header>

    <main class="container my-5 flex-grow-1">

        <div class="bg-white p-4 rounded shadow">

            <h2 class="text-primary mb-4">Meu perfil</h2>

            <% if (erro) { %>
                <div class="alert alert-danger"><%= erro %></div>
            <% } %>

            <div class="bg-light border rounded p-4 mb-4">
                <h4>Informações da conta</h4>

                <p><strong>Nome:</strong> <%= usuario.name %></p>
                <p><strong>E-mail:</strong> <%= usuario.email %></p>
                <p class="mb-0"><strong>Tipo de conta:</strong> <%= usuario.tipo %></p>
            </div>

            <div class="bg-light border rounded p-4 mb-4">
                <h4 class="text-primary mb-3">Editar informações</h4>

                <form id="formPerfil" action="/usuarios/perfil" method="POST">

                    <div class="mb-3">
                        <label for="nome" class="form-label">Nome</label>
                        <input type="text" class="form-control" id="nome" name="name"
                            value="<%= usuario.name %>" required>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">E-mail</label>
                        <input type="email" class="form-control" id="email" name="email"
                            value="<%= usuario.email %>" required>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Salvar alterações
                    </button>

                </form>
            </div>

            <div class="bg-light border rounded p-4">
                <h4 class="text-primary mb-3">Meus empréstimos</h4>

                <% if (emprestimos.length === 0) { %>
                    <p class="mb-0">Você ainda não tem empréstimos.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover bg-white">
                            <thead class="table-primary">
                                <tr>
                                    <th>Livro</th>
                                    <th>Data</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% emprestimos.forEach((emp) => { %>
                                    <tr>
                                        <td><%= emp.titulo %></td>
                                        <td><%= emp.data %></td>
                                        <td>
                                            <% if (emp.status === 'Aprovado') { %>
                                                <span class="badge bg-success">Aprovado</span>
                                            <% } else if (emp.status === 'Pendente') { %>
                                                <span class="badge bg-warning text-dark">Pendente</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary"><%= emp.status %></span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>

            <a href="/" class="btn btn-outline-primary mt-4">
                Voltar
            </a>

        </div>

    </main>

    <footer class="bg-white text-center p-3 border-top mt-auto">
        <p class="mb-0">© 2026 Biblioteca. Todos os direitos reservados.</p>
    </footer>

</body>
</html>